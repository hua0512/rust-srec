# ============================================================
# Rust-Srec Environment Configuration
# ============================================================
# Copy this file to .env and configure the values

# ============================================================
# Timezone Configuration
# ============================================================
TZ=UTC

# ============================================================
# Docker Image Version
# ============================================================
VERSION=latest

# ============================================================
# Directory Paths (Host Volumes)
# ============================================================
DATA_DIR=./data
CONFIG_DIR=./config
OUTPUT_DIR=./output
LOG_DIR=./logs

# ============================================================
# Port Configuration
# ============================================================
API_PORT=12555
FRONTEND_PORT=15275

# ============================================================
# Backend Configuration
# ============================================================

# Logging level: trace, debug, info, warn, error
RUST_LOG=info

# Database connection string
DATABASE_URL=sqlite:///app/data/rust-srec.db

# Strict backend shutdown deadline in seconds. The final 2 seconds are reserved
# for forcefully containing the isolated runtime if graceful shutdown stalls.
RUST_SREC_SHUTDOWN_TIMEOUT_SECS=30
RUST_SREC_SHUTDOWN_FORCE_RESERVE_SECS=2
# Docker Compose must wait longer than the backend deadline before SIGKILL.
RUST_SREC_CONTAINER_STOP_GRACE_PERIOD=35s

# Optional override. The default marker is stored beside the SQLite database.
# RUST_SREC_RUNTIME_MARKER_PATH=/app/data/rust-srec.db.runtime-generation.dirty

# ============================================================
# Output-root write gate (#508)
# ============================================================
# Comma-separated absolute paths treated as output-root boundaries for the
# write gate. If unset, the gate auto-discovers mount roots from every
# config layer (global, platform, template, per-streamer). Set explicitly
# to probe additional mounts that aren't yet referenced by any streamer
# config, or to consolidate a /rec/{platform}/... layout under a single
# /rec gate key.
# RUST_SREC_OUTPUT_ROOTS=/rec,/mnt/backup

# ============================================================
# Backend Locale
# ============================================================
# Locale for backend-emitted notification strings. Affects every
# notification event (stream lifecycle, download, segment, pipeline,
# system alerts, credential events) — all delivered to Telegram, Gotify,
# Discord, webhook, email, and web push in the chosen language.
# Supported: en, zh-CN. Defaults to en.
# RUST_SREC_LOCALE=en

# ============================================================
# JWT Authentication (REQUIRED)
# ============================================================

# Secret key for signing JWT tokens (REQUIRED - generate a secure random string)
JWT_SECRET=

# JWT issuer and audience identifiers
JWT_ISSUER=rust-srec
JWT_AUDIENCE=rust-srec-api

# ============================================================
# Token Expiration
# ============================================================

# Access token lifetime in seconds (default: 1 hour)
ACCESS_TOKEN_EXPIRATION_SECS=3600

# Refresh token lifetime in seconds (default: 7 days)
REFRESH_TOKEN_EXPIRATION_SECS=604800

# ============================================================
# Password Policy
# ============================================================

# Minimum password length
MIN_PASSWORD_LENGTH=8

# ============================================================
# Resource Limits (Docker)
# ============================================================
# CPU_LIMIT=4
# MEMORY_LIMIT=4G
# CPU_RESERVATION=1
# MEMORY_RESERVATION=512M

# ============================================================
# Automatic Updates (Watchtower, Optional)
# ============================================================
# Only used when the `autoupdate` profile is running:
#   docker compose --profile autoupdate up -d
# Requires a mutable image tag (VERSION=latest or dev); pinned vX.Y.Z tags
# never receive updates. Containers are only recreated while idle
# (no recording, no running pipeline job) — see GET /api/health/idle.
#
# Seconds between update checks (default: 3600 = 1 hour).
# WATCHTOWER_POLL_INTERVAL=3600

# ============================================================
# Proxy Configuration (Optional)
# ============================================================
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080
# NO_PROXY=localhost,127.0.0.1,rust-srec

# ============================================================
# Frontend Configuration
# ============================================================

# Backend API URL (internal Docker network URL)
BACKEND_URL=http://rust-srec:8080

# Session cookie encryption secret (REQUIRED - min 32 characters)
SESSION_SECRET=

# Cookie secure flag: 'true' = always, 'false' = never, or leave empty for auto-detection
# Auto-detection uses X-Forwarded-Proto header (recommended when behind a reverse proxy)
COOKIE_SECURE=

# ============================================================
# Browser Notifications (Web Push / VAPID) (Optional)
# ============================================================
# Generate VAPID keys (base64url, unpadded), e.g.:
#   docker run --rm ghcr.io/hua0512/rust-srec:${VERSION:-latest} /app/rust-srec-vapid
#   # or: npx --yes web-push generate-vapid-keys
#
# Note: Browsers require HTTPS (or localhost) for push notifications.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:admin@localhost
