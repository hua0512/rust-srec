# add git-ignore syntax here of things you don't want copied into docker image

.results
scripts
*Dockerfile*
node_modules
.env
.output
.tanstack
.nitro
.nuxt
dist
dist-desktop

# Local SQLite databases. A development database left in this directory would
# otherwise be carried into the build stage by `COPY . .`.
*.db
*.db-wal
*.db-shm
*.db-journal

# Local environment overrides. The image is configured through runtime
# environment variables, and a local file would silently win over them at
# build time.
.env.local
.env.production
.env.*.local
