# add git-ignore syntax here of things you don't want copied into docker image

.results
scripts
*Dockerfile*
node_modules
.env
.output
.tanstack
.nitro
.nuxt
dist
dist-desktop

# Local SQLite databases. A development database left anywhere in the build
# context would otherwise be carried into the build stage by `COPY . .`.
**/*.db
**/*.db-wal
**/*.db-shm
**/*.db-journal

# Local environment overrides. `pnpm run build` reads them and bakes any
# VITE_* values they set, such as an API base URL, into the client bundle.
.env.local
.env.production
.env.*.local
