# WebSocket connection upgrade mapping
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Client-facing scheme for the X-Forwarded-Proto sent upstream. This server only
# listens on plain HTTP, so $scheme is never https; when an external TLS
# terminator already set X-Forwarded-Proto, the request is reported as https. A
# proxy chain sends the client-facing hop first, so matching the start of the
# value is enough.
map $http_x_forwarded_proto $forwarded_proto {
    default   $scheme;
    ~*^https  https;
}

server {
    listen 80;
    server_name localhost;

    # Browser hardening for every response this server produces. `always` also
    # covers proxied error and redirect responses, which nginx otherwise leaves
    # bare. A location that adds a header of its own would replace this whole
    # set rather than extend it, so the proxy locations below add none.
    #
    # Framing is restricted through X-Frame-Options rather than a CSP
    # `frame-ancestors` directive: the application inlines its hydration
    # scripts and so cannot carry a complete CSP, and a Content-Security-Policy
    # header holding a single directive would suggest otherwise.
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    # Gzip compression
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied expired no-cache no-store private auth;
    gzip_types text/plain text/css text/xml text/javascript application/x-javascript application/xml application/javascript application/json;

    # Proxy root to Node.js SSR server
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }

    # API proxy - backend URL is configurable via environment variable
    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        # The download-progress and log-streaming WebSockets live under /api/
        # and send nothing while the backend is quiet. nginx's 60s default
        # would drop those idle connections, so the budget is raised to an
        # hour; the browser reconnects on a genuinely dead connection.
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }
}
