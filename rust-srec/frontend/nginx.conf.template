# WebSocket connection upgrade mapping
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Client-facing scheme for the X-Forwarded-Proto sent upstream. This server only
# listens on plain HTTP, so $scheme is never https; when an external TLS
# terminator already set X-Forwarded-Proto, the request is reported as https. A
# proxy chain sends the client-facing hop first, so matching the start of the
# value is enough.
map $http_x_forwarded_proto $forwarded_proto {
    default   $scheme;
    ~*^https  https;
}

# Request path without its query string, for the access log. Media and
# WebSocket URLs carry the sign-in token as `?token=`, and the log would
# otherwise keep a copy of every one. The error log still shows the full
# request line when the backend cannot be reached; nginx has no setting to
# change what an error entry contains.
map $request_uri $log_path {
    ~^(?<uri_path>[^?]*)  $uri_path;
}

log_format redacted '$remote_addr - $remote_user [$time_local] '
                    '"$request_method $log_path $server_protocol" '
                    '$status $body_bytes_sent "$http_referer" '
                    '"$http_user_agent" "$http_x_forwarded_for"';

server {
    listen 80;
    server_name localhost;

    server_tokens off;
    access_log /var/log/nginx/access.log redacted;

    # Browser hardening for every response this server produces. `always` also
    # covers 4xx and 5xx responses, including proxied errors, which nginx
    # otherwise leaves bare. A location that adds a header of its own would
    # replace this whole set rather than extend it, so the proxy locations
    # below add none.
    #
    # Framing is left open so dashboards on another port or subdomain can embed
    # the UI. The session cookie is SameSite=Lax, so a frame on an unrelated
    # site loads signed out.
    #
    # The Content-Security-Policy leaves scripts and styles unrestricted. Every
    # server-rendered page carries inline scripts (the router's hydration data
    # and the theme and sidebar pre-paint scripts) whose content changes per
    # request, so hashes cannot cover them, and a nonce would have to come from
    # the SSR server rather than from here. A `script-src` that still allowed
    # 'unsafe-inline' would block nothing, so only the directives that hold
    # regardless are set.
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Content-Security-Policy "object-src 'none'; base-uri 'self'; form-action 'self'" always;

    # Gzip compression
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied expired no-cache no-store private auth;
    gzip_types text/plain text/css text/xml text/javascript application/x-javascript application/xml application/javascript application/json;

    # Proxy root to Node.js SSR server
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        # The Host the browser sent, port included: the SSR server's CSRF check
        # compares it with the page's Origin, and `$host` drops the port.
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }

    # API proxy - backend URL is configurable via environment variable
    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }
}
