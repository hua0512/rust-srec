{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "external-web-links",
  "description": "Open web links from the main window in the default browser",
  "windows": ["main"],
  "permissions": [
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "http://*" },
        { "url": "https://*" }
      ]
    }
  ]
}
